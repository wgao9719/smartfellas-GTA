; Install as scripts/LivingNPC/LivingNPC.ini. Logs use the same directory.

[Service]
; Read literally by the adapter (including : and //); do not quote values or add inline comments.
; Use an absolute http URL with a numeric loopback IP and port. Invalid URLs fall back to this default.
URL=http://127.0.0.1:8765
; Required: choose a unique profile for a new/unknown save lineage. Never reuse it for another slot.
ProfileId=
; Required: your explicit save-slot label. The adapter cannot infer a save GUID from game time.
SaveSlot=
; Set only when selecting an existing save lineage explicitly.
ParentBranchId=
; Debug only: permits private/Tailscale IPv4 with a bootstrap token of at least 24 characters.
DevLAN=false
; Prefer LLS_BRIDGE_TOKEN in the game process environment. INI token punctuation is preserved.
BootstrapToken=

[Input]
; Verify the current save/profile warning before each new session. Check for key conflicts on the rig.
ConfirmProfileKey=F10
TargetKey=F6
TextKey=F7
PttKey=N
; Hold to whisper. Verify on the rig that B does not conflict with a game binding.
WhisperKey=B
; Outside typing, cancel and clear selection. Escape remains reserved for GTA pause.
CancelKey=Back
; Press twice within 5 seconds to pin the selected pedestrian. Check for key conflicts on the rig.
PinKey=F8

[Compatibility]
ScriptHookVBuild=UNVERIFIED
ServiceOS=windows

[Development]
; Debug builds only. This enables unverified G0 face/wait primitives for rig testing.
EnableUnverifiedActions=false
; Debug builds only. Keeps pinned peds from despawning through an unverified persistence call.
EnableUnverifiedPinPersistence=false
