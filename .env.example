# These values are examples. The service reads process environment variables.
# It does not automatically load this file.
LLS_HOST=127.0.0.1
LLS_PORT=8765
LLS_PROVIDER=disabled
LLS_CLOUD_OPT_IN=0
LLS_RELEASE=1
LLS_DEV_LAN=0
# LLS_DATABASE=/absolute/private/path/lls.sqlite3
# LLS_BRIDGE_TOKEN=<generate-a-local-secret>

# Local OpenAI-compatible AI uses a literal loopback address and explicit model.
# The server must already be installed and running on the service computer.
# LLS_PROVIDER=local_openai
# LLS_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
# LLM_DIALOGUE_MODEL=<your-local-model>
# LLM_ACTION_MODEL=<your-local-model>

# Optional semantic retrieval. Disabled embeddings preserve lexical retrieval.
# Embeddings share provider budgets and explicit cloud consent.
# LLS_EMBEDDING_PROVIDER=local_openai
# LLM_EMBEDDING_MODEL=<your-installed-embedding-model>
# LLS_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# LLS_EMBEDDING_DIMENSIONS=768

# Hosted AI requires an explicit choice. Keep credentials outside Git.
# Configure current model prices and daily limits through the local dashboard.
# Save settings, then enable cloud for the reviewed configuration.
# Saved provider settings and consent override these environment examples.
# LLS_PROVIDER=openai
# LLS_CLOUD_OPT_IN=1
# LLS_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_DIALOGUE_MODEL=<your-model>
# LLM_ACTION_MODEL=<your-model>
# LLM_API_KEY=<your-key>

# Speech remains local to the service computer and requires installed models.
# Startup does not open the microphone. Push-to-talk starts capture.
# LLS_SPEECH_ENABLED=1
# LLS_WHISPER_EXECUTABLE=/absolute/path/to/whisper-cli
# LLS_WHISPER_MODEL=/absolute/path/to/ggml-base.en.bin
# LLS_TTS_PROVIDER=piper
# LLS_PIPER_EXECUTABLE=/absolute/path/to/piper
# LLS_PIPER_MODEL=/absolute/path/to/licensed-voice.onnx
# LLS_INPUT_DEVICE=<device-index, name, or host-API:name such as WASAPI:Speakers>
# LLS_OUTPUT_DEVICE=<device-index, name, or host-API:name such as WASAPI:Speakers>
# LLS_STT_ACTION_CONFIDENCE=0.85
# Finite confidence below this is refused. Unknown confidence stays dialogue-only.
# LLS_STT_DIALOGUE_CONFIDENCE=0.3
# Captures quieter than this RMS level (-96 to -20 dBFS) never reach whisper.cpp.
# LLS_STT_SILENCE_DBFS=-60

# Social simulation requires explicit development settings and adapter capability.
# Release adapters do not advertise development:social:v1.
# LLS_RELEASE=0
# LLS_DEV_SOCIAL=1
# Optional automatic development invitations and turns. Requires the social gate above.
# Hearing evidence must still arrive separately through the bridge.
# LLS_DEV_SOCIAL_AUTONOMY=1

# Declarative skills require a development adapter capability and acknowledged actions.
# LLS_RELEASE=0
# LLS_DEV_SKILLS=1
# Optional automatic practice from accepted external action evidence.
# LLS_DEV_SKILL_AUTONOMY=1

# Virtual neighborhood routes require an explicit authored JSON pack.
# They do not spawn GTA actors. Initialize the neighborhood explicitly.
# LLS_RELEASE=0
# LLS_DEV_NEIGHBORHOOD=1
# LLS_NEIGHBORHOOD_PACK=/absolute/path/to/authored-neighborhood.json
# Optional bounded automatic advancement from eligible world snapshots.
# LLS_DEV_NEIGHBORHOOD_AUTONOMY=1

# Prefer the Windows-local service with SSH deployment over Tailscale.
# Dev-LAN is available only when explicitly enabled outside release mode.
# LLS_RELEASE=0
# LLS_DEV_LAN=1
# LLS_HOST=<this-computers-private-or-tailscale-address>
# LLS_ALLOW_SOURCES=<exact-game-rig-ip-address>
# LLS_BRIDGE_TOKEN=<matching-long-random-secret>
